# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local은 git에 올라가지 않습니다)

# 카카오 JavaScript 키 — 브라우저 지도 표시용 (도메인 제한으로 보호)
VITE_KAKAO_JS_KEY=

# 길찾기(이동 시간) — 브라우저에서 호출됨. 발급 방법: docs/route-api-keys.md
# TMAP(SK open API) 앱 키 — 자동차·도보 경로 (노출되므로 무료 요금제로만 사용)
VITE_TMAP_APP_KEY=
# ODsay LAB Web 키 — 대중교통 경로 (등록한 URI에서만 동작)
VITE_ODSAY_API_KEY=

# 아래 두 키는 데이터 수집 스크립트에서만 사용되며 브라우저로 나가지 않습니다.
# 공공데이터포털 TourAPI 서비스키 (디코딩 키)
TOUR_API_KEY=
# 카카오 REST API 키
KAKAO_REST_KEY=

# (선택) 기상청 단기예보 서비스키. 비워두면 TOUR_API_KEY를 사용합니다.
# 공공데이터포털에서 '기상청_단기예보 ((구)_동네예보) 조회서비스'를 활용신청하면 같은 키로 동작합니다.
KMA_API_KEY=

# (선택) 네이버 개발자센터 검색 API — 블로그 언급순 정렬 (데이터 수집에서만 사용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local은 git에 올라가지 않습니다)

# 카카오 JavaScript 키 — 브라우저 지도 표시용 (도메인 제한으로 보호)
VITE_KAKAO_JS_KEY=

# 길찾기(이동 시간) — 브라우저에서 호출하며 각 콘솔에서 도메인을 제한해 보호
# TMAP(SK open API) 앱 키 — 자동차·도보 경로
VITE_TMAP_APP_KEY=
# ODsay LAB Web 키 — 대중교통 경로
VITE_ODSAY_API_KEY=

# 아래 두 키는 데이터 수집 스크립트에서만 사용되며 브라우저로 나가지 않습니다.
# 공공데이터포털 TourAPI 서비스키 (디코딩 키)
TOUR_API_KEY=
# 카카오 REST API 키
KAKAO_REST_KEY=
